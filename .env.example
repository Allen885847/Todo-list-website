DEEPSEEK_API_KEY=replace_with_your_new_key
PORT=4173

# Exact browser origin. Use HTTPS in production.
APP_ORIGIN=http://127.0.0.1:4173
# Generate a random secret with at least 32 characters; never commit it.
AUTH_SECRET=
# Persistent account database. Keep outside the public/static directory.
AUTH_DB_PATH=./data/auth.sqlite

# NetEase 163 SMTP over TLS. Full sender address and client authorization code.
# SMTP_PASS is NOT the mailbox login password. Never put credentials in frontend code.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
