{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo-list-online",
  "main": "src/cloudflare-worker.mjs",
  "workers_dev": true,
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "todolist.uno",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-list-online",
      "database_id": "d2b3d984-ddbf-473b-af8a-a8d26cc84291",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "todo-list-online-files"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://todolist.uno",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://todolist.uno,https://todo-list-online.allenwhy888.workers.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFYikpnJBINL2qnU",
    "TURNSTILE_HOSTNAMES": "todolist.uno,todo-list-online.allenwhy888.workers.dev",
    "QQ_SMTP_FROM_NAME": "Todo List"
  },
  "observability": {
    "enabled": true
  }
}
