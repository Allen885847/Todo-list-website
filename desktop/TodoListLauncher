#!/bin/zsh

STABLE_DIR="/Users/wanghaoyu/Desktop/MyCode/Todo-list-website-v3.0"
STABLE_PORT="4192"
CALENDAR_URL="http://127.0.0.1:${STABLE_PORT}/app.html#calendar"
HEALTH_URL="http://127.0.0.1:${STABLE_PORT}/calendar.html"
LOG_FILE="${HOME}/Library/Logs/AI-Todo-List-v3.0.log"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

show_error() {
  /usr/bin/osascript -e "display alert \"AI Todo List V3.0 could not start\" message \"$1\" as critical buttons {\"OK\"} default button \"OK\""
}

open_calendar() {
  /usr/bin/open -a "Safari" "$CALENDAR_URL"
}

if [[ ! -d "$STABLE_DIR" ]]; then
  show_error "The V3.0 folder was not found at: $STABLE_DIR"
  exit 1
fi

if [[ ! -f "$STABLE_DIR/.env" ]]; then
  show_error "The local API configuration is missing from the V3.0 folder."
  exit 1
fi

if /usr/bin/curl --fail --silent "$HEALTH_URL" | /usr/bin/grep --quiet "Calendar · Todo List"; then
  open_calendar
  exit 0
fi

/bin/mkdir -p "${HOME}/Library/Logs"
cd "$STABLE_DIR" || exit 1
/usr/bin/nohup /usr/bin/env PORT="$STABLE_PORT" npm start >> "$LOG_FILE" 2>&1 &

for attempt in {1..40}; do
  if /usr/bin/curl --fail --silent "$HEALTH_URL" | /usr/bin/grep --quiet "Calendar · Todo List"; then
    open_calendar
    exit 0
  fi
  /bin/sleep 0.25
done

show_error "The V3.0 server did not become ready. See ${LOG_FILE} for details."
exit 1
